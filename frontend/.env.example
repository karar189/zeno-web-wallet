# Copy to frontend/.env.local and restart `npm run dev`.
# NEXT_PUBLIC_* values are baked in at dev-server start and at build time.
# Do not put seeds, passwords, session tokens, or viewing keys in this file.

# simulated (default when unset) or live
NEXT_PUBLIC_WALLET_BACKEND=simulated

# Used for session, funding, live payments, and disclosure.
# Must be a loopback URL. The wallet service rejects any other Host.
NEXT_PUBLIC_WALLET_URL=http://127.0.0.1:8787

# Wallet service used when the header toggle is on mainnet. Must be loopback.
NEXT_PUBLIC_MAINNET_WALLET_URL=http://127.0.0.1:8788

# Legacy Nest quote/privacy client. The route explorer uses the Next.js API route.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Read by an unmounted engine report component. No current page calls it.
# NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:4010

# Optional server-only 1Click partner key for quotes, deposits, and status.
# JWT values are sent as Authorization: Bearer; other values as X-API-Key.
# Never prefix this variable with NEXT_PUBLIC_.
# NEAR_INTENTS_API_KEY=

# Optional Zcash Names (ZNS) indexer overrides for pay-by-name resolution.
# Defaults come from zcashname-sdk (testnet: light.zcash.me/zns-testnet).
# ZNS_TESTNET_URL=https://light.zcash.me/zns-testnet
# ZNS_MAINNET_URL=https://main.zcashnames.com

# Optional Instant Sync server (testnet beta). Off unless set AND the user enables it in Settings.
# NEXT_PUBLIC_INSTANT_SYNC_URL=http://127.0.0.1:8795
